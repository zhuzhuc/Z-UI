# Z-UI Environment Configuration
# Copy to /etc/z-ui/z-ui.env and edit values.
# chown z-ui:z-ui /etc/z-ui/z-ui.env && chmod 600 /etc/z-ui/z-ui.env

# --- Required ---
# First admin credentials (only used on first startup, then stored in DB)
PANEL_USERNAME=admin
PANEL_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD

# Session signing secret (auto-generated if using ZUI_SECRET_FILE, or set manually)
# PANEL_SECRET=CHANGE_ME_TO_RANDOM_64_HEX_CHARS

# Public URL for your panel
PANEL_PUBLIC_BASE=https://panel.example.com

# --- Security ---
# CORS origins (comma-separated, or * for any — not recommended for production)
CORS_ALLOW_ORIGINS=https://panel.example.com

# Trusted proxy IPs for X-Forwarded-For parsing
TRUSTED_PROXIES=127.0.0.1,::1

# Strict production mode — fails if default admin password is still in use
ZUI_STRICT_PRODUCTION=1

# Login rate limiting
AUTH_MAX_FAILURES=5
AUTH_FAIL_WINDOW_SEC=600
AUTH_LOCK_SEC=900

# Session duration (hours)
AUTH_SESSION_HOURS=24

# Cookie settings
AUTH_COOKIE_NAME=zui_session
AUTH_COOKIE_SECURE=1

# --- Paths ---
# ZUI_DB=/opt/z-ui/data/zui.db
# ZUI_FRONT_DIR=/opt/z-ui/front/dist
# ZUI_SECRET_FILE=/opt/z-ui/data/.panel_secret

# --- Xray ---
XRAY_CONTROL=systemd
XRAY_SERVICE=xray
# XRAY_CONFIG=/opt/z-ui/runtime/xray-config.json
# XRAY_ACCESS_LOG=/opt/z-ui/runtime/xray-access.log
# XRAY_ERROR_LOG=/opt/z-ui/runtime/xray-error.log

# Process mode (alternative to systemd):
# XRAY_CONTROL=process
# XRAY_BIN=/opt/z-ui/bin/xray

# --- Logging ---
# ZUI_LOG_LEVEL=info
# ZUI_LOG_FORMAT=json
